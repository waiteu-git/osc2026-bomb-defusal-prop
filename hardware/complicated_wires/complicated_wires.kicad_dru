(version 1)

# OSC2026 shared design rules for JLCPCB (2-layer, 1.6mm, 1oz). GENERATED by
# hardware/design_rules/apply_design_rules.py - edit that script, not this file.
# Syntax notes (KiCad 10.0.3): last matching rule of a constraint wins; no regex in conditions;
# a parse error is NOT reported by kicad-cli (all rules silently dropped) - run check_design_rules.py.

(rule "osc_3v3_min_track_0p3"
	(constraint track_width (min 0.3mm))
	(condition "A.NetName == '+3.3V' || A.NetName == '+3V3'"))

(rule "osc_power_min_track_0p5"
	(constraint track_width (min 0.5mm))
	(condition "A.NetName == '+5V' || A.NetName == 'VCC_J*' || A.NetName == '/VCC_J*' || A.NetName == 'TM_VDD' || A.NetName == '/TM_VDD'"))

(rule "osc_pth_min_ring_0p18"
	(constraint annular_width (min 0.18mm))
	(condition "A.Type == 'Pad' && A.isPlated()"))

(rule "osc_pth_min_drill_0p5"
	(constraint hole_size (min 0.5mm))
	(condition "A.Type == 'Pad' && A.isPlated()"))

(rule "osc_npth_min_drill_0p5"
	(constraint hole_size (min 0.5mm))
	(condition "A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical'"))

# SK6812MINI-E reverse-mount footprints (D1, D2, D3, D4, D5, D6, D7, D8, D9, D10, D11, D12, D13, D14, D15, D16, D17, D18, D19, D20) carry their own Edge.Cuts light window,
# 0.2467 mm from the pads; JLCPCB's routed-edge floor is 0.2 mm.
(rule "osc_led_window_edge"
	(constraint edge_clearance (min 0.2mm))
	(condition "A.Type == 'Pad' && (A.memberOfFootprint('D1') || A.memberOfFootprint('D2') || A.memberOfFootprint('D3') || A.memberOfFootprint('D4') || A.memberOfFootprint('D5') || A.memberOfFootprint('D6') || A.memberOfFootprint('D7') || A.memberOfFootprint('D8') || A.memberOfFootprint('D9') || A.memberOfFootprint('D10') || A.memberOfFootprint('D11') || A.memberOfFootprint('D12') || A.memberOfFootprint('D13') || A.memberOfFootprint('D14') || A.memberOfFootprint('D15') || A.memberOfFootprint('D16') || A.memberOfFootprint('D17') || A.memberOfFootprint('D18') || A.memberOfFootprint('D19') || A.memberOfFootprint('D20'))"))

# ---- corner keep-out: four 12 x 12 mm squares at the corners of the 80 x 80 mm panel ----
# Only reference points are tested (pad/via centre, track end points, footprint origin).
# Copper that merely reaches into a square from outside is not caught.
# Exception: LED1 (documented in design_rules.md)
(rule "osc_corner_keepout_pad"
	(constraint disallow pad)
	(condition "A.Type == 'Pad' && A.Pad_Type != 'NPTH, mechanical' && !A.memberOfFootprint('LED1') && ((A.Position_X >= 112.776mm && A.Position_X <= 124.776mm) || (A.Position_X >= 180.776mm && A.Position_X <= 192.776mm)) && ((A.Position_Y >= 29.845mm && A.Position_Y <= 41.845mm) || (A.Position_Y >= 97.845mm && A.Position_Y <= 109.845mm))"))

(rule "osc_corner_keepout_via"
	(constraint disallow via)
	(condition "A.Type == 'Via' && !A.intersectsCourtyard('LED1') && ((A.Position_X >= 112.776mm && A.Position_X <= 124.776mm) || (A.Position_X >= 180.776mm && A.Position_X <= 192.776mm)) && ((A.Position_Y >= 29.845mm && A.Position_Y <= 41.845mm) || (A.Position_Y >= 97.845mm && A.Position_Y <= 109.845mm))"))

(rule "osc_corner_keepout_track"
	(constraint disallow track)
	(condition "A.Type == 'Track' && !A.intersectsCourtyard('LED1') && (((((A.Start_X >= 112.776mm && A.Start_X <= 124.776mm) || (A.Start_X >= 180.776mm && A.Start_X <= 192.776mm))) && (((A.Start_Y >= 29.845mm && A.Start_Y <= 41.845mm) || (A.Start_Y >= 97.845mm && A.Start_Y <= 109.845mm)))) || ((((A.End_X >= 112.776mm && A.End_X <= 124.776mm) || (A.End_X >= 180.776mm && A.End_X <= 192.776mm))) && (((A.End_Y >= 29.845mm && A.End_Y <= 41.845mm) || (A.End_Y >= 97.845mm && A.End_Y <= 109.845mm)))))"))

(rule "osc_corner_keepout_footprint"
	(constraint disallow footprint)
	(condition "A.Type == 'Footprint' && A.Library_Link != 'MountingHole:*' && A.Reference != 'LED1' && ((A.Position_X >= 112.776mm && A.Position_X <= 124.776mm) || (A.Position_X >= 180.776mm && A.Position_X <= 192.776mm)) && ((A.Position_Y >= 29.845mm && A.Position_Y <= 41.845mm) || (A.Position_Y >= 97.845mm && A.Position_Y <= 109.845mm))"))
