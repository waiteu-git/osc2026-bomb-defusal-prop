		(comp
			(ref "NP1")
			(value "WS2812B")
			(footprint "LED_SMD:LED_WS2812B_PLCC4_5.0x5.0mm_P3.2mm")
			(description "Side-strip NeoPixel pixel (WS2812B-compatible 5050; SK6812 has the same footprint but a different pinout, so check the symbol before swapping). 6 pixels in a vertical line, about 42 mm. DIN of the first pixel comes from GP9 via R10. No per-pixel bypass capacitor (user decision 2026-10-01; datasheet recommends 0.1uF each). DIN high level >=0.7*VDD (3.5V) is marginal at 3.3V; verify on the real part. Cap brightness in firmware.")
			(fields
				(field
					(name "Footprint") "LED_SMD:LED_WS2812B_PLCC4_5.0x5.0mm_P3.2mm")
