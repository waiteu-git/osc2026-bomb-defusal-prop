			(ref "SW9")
			(value "Mode select")
			(footprint "FourButton_Local:SW_Slide_2P")
			(description "Hardware mode-select switch (2-position slide/toggle, proposal per hub discussion 2026-10-01): GP11 internal pull-up, GND = one mode (e.g. diamond/Simon), open = the other (grid/Keypad). Lets one firmware image serve both modes; final adoption is a software-team decision (re-flashing per mode is the hardware-free alternative).")
			(fields
				(field
					(name "Footprint") "FourButton_Local:SW_Slide_2P")
