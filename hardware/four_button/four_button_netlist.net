		(comp
			(ref "D1")
			(value "SK6812 Red")
			(footprint "LED_SMD:LED_SK6812_PLCC4_5.0x5.0mm_P3.2mm")
			(description "Addressable RGB LED (NeoPixel-compatible), Red key. Replaces the discrete LED+2SC1815+resistor driver. 2026-10-01: initially chose WS2812B 5050 SMD over SK6812MINI-E (the latter used in complicated_wires but hard to hand-solder); later changed to the full-size SK6812 5050 (same PLCC4 5.0x5.0mm package/footprint as WS2812B, same physical pin layout, but KiCad's stock SK6812 symbol numbers the pins differently -- pin1=VSS,2=DIN,3=VDD,4=DOUT vs WS2812B's 1=VDD,2=DOUT,3=VSS,4=DIN; verified against both stock library symbols before wiring). Daisy-chained GP6->R10->D1->D2->D3->D4 (chain order = dict order Red/Blue/Green/Yellow); firmware addresses each LED by chain position, colour is software-assigned (not fixed by the LED itself). Pin1=VSS(GND), pin2=DIN, pin3=VDD(+5V), pin4=DOUT. Placed near the Red(left) key (not aligned to the switch's LED window -- user decision: thin keycap + indirect lighting, see four_button_design_notes.md).")
			(fields
				(field
					(name "Footprint") "LED_SMD:LED_SK6812_PLCC4_5.0x5.0mm_P3.2mm")
				(field
					(name "Datasheet")
				)
				(field
					(name "Description") "Addressable RGB LED (NeoPixel-compatible), Red key. Replaces the discrete LED+2SC1815+resistor driver. 2026-10-01: initially chose WS2812B 5050 SMD over SK6812MINI-E (the latter used in complicated_wires but hard to hand-solder); later changed to the full-size SK6812 5050 (same PLCC4 5.0x5.0mm package/footprint as WS2812B, same physical pin layout, but KiCad's stock SK6812 symbol numbers the pins differently -- pin1=VSS,2=DIN,3=VDD,4=DOUT vs WS2812B's 1=VDD,2=DOUT,3=VSS,4=DIN; verified against both stock library symbols before wiring). Daisy-chained GP6->R10->D1->D2->D3->D4 (chain order = dict order Red/Blue/Green/Yellow); firmware addresses each LED by chain position, colour is software-assigned (not fixed by the LED itself). Pin1=VSS(GND), pin2=DIN, pin3=VDD(+5V), pin4=DOUT. Placed near the Red(left) key (not aligned to the switch's LED window -- user decision: thin keycap + indirect lighting, see four_button_design_notes.md).")
			)
