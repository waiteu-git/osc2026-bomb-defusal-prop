(version 1)

# OSC2026 shared design rules for JLCPCB (2-layer, 1.6mm, 1oz). GENERATED by
# hardware/design_rules/apply_design_rules.py - edit that script, not this file.
# Syntax notes (KiCad 10.0.3): last matching rule of a constraint wins; no regex in conditions;
# a parse error is NOT reported by kicad-cli (all rules silently dropped) - run check_design_rules.py.

(rule "osc_3v3_min_track_0p3"
	(constraint track_width (min 0.3mm))
	(condition "A.NetName == '+3.3V' || A.NetName == '+3V3' || A.NetName == '+3V3_H' || A.NetName == '/+3V3_H'"))

(rule "osc_power_min_track_0p5"
	(constraint track_width (min 0.5mm))
	(condition "A.NetName == '+5V' || A.NetName == 'VCC_J*' || A.NetName == '/VCC_J*' || A.NetName == 'TM_VDD' || A.NetName == '/TM_VDD'"))

(rule "osc_pth_min_ring_0p18"
	(constraint annular_width (min 0.18mm))
	(condition "A.Type == 'Pad' && A.isPlated()"))

(rule "osc_pth_min_drill_0p5"
	(constraint hole_size (min 0.5mm))
	(condition "A.Type == 'Pad' && A.isPlated()"))

(rule "osc_npth_min_drill_0p5"
	(constraint hole_size (min 0.5mm))
	(condition "A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical'"))

# ---- corner keep-out: four 12 x 12 mm squares at the corners of the 80 x 80 mm panel ----
# Only reference points are tested (pad/via centre, track end points, footprint origin).
# Copper that merely reaches into a square from outside is not caught.
# Exception: D5 (documented in design_rules.md)
(rule "osc_corner_keepout_pad"
	(constraint disallow pad)
	(condition "A.Type == 'Pad' && A.Pad_Type != 'NPTH, mechanical' && !A.memberOfFootprint('D5') && ((A.Position_X >= 0mm && A.Position_X <= 12mm) || (A.Position_X >= 68mm && A.Position_X <= 80mm)) && ((A.Position_Y >= 0mm && A.Position_Y <= 12mm) || (A.Position_Y >= 68mm && A.Position_Y <= 80mm))"))

(rule "osc_corner_keepout_via"
	(constraint disallow via)
	(condition "A.Type == 'Via' && !A.intersectsCourtyard('D5') && ((A.Position_X >= 0mm && A.Position_X <= 12mm) || (A.Position_X >= 68mm && A.Position_X <= 80mm)) && ((A.Position_Y >= 0mm && A.Position_Y <= 12mm) || (A.Position_Y >= 68mm && A.Position_Y <= 80mm))"))

(rule "osc_corner_keepout_track"
	(constraint disallow track)
	(condition "A.Type == 'Track' && !A.intersectsCourtyard('D5') && (((((A.Start_X >= 0mm && A.Start_X <= 12mm) || (A.Start_X >= 68mm && A.Start_X <= 80mm))) && (((A.Start_Y >= 0mm && A.Start_Y <= 12mm) || (A.Start_Y >= 68mm && A.Start_Y <= 80mm)))) || ((((A.End_X >= 0mm && A.End_X <= 12mm) || (A.End_X >= 68mm && A.End_X <= 80mm))) && (((A.End_Y >= 0mm && A.End_Y <= 12mm) || (A.End_Y >= 68mm && A.End_Y <= 80mm)))))"))

(rule "osc_corner_keepout_footprint"
	(constraint disallow footprint)
	(condition "A.Type == 'Footprint' && A.Library_Link != '*MountingHole*' && A.Reference != 'D5' && ((A.Position_X >= 0mm && A.Position_X <= 12mm) || (A.Position_X >= 68mm && A.Position_X <= 80mm)) && ((A.Position_Y >= 0mm && A.Position_Y <= 12mm) || (A.Position_Y >= 68mm && A.Position_Y <= 80mm))"))
