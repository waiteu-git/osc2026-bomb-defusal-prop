		(property "Description" "Local decoupling capacitor for D1 (VDD-VSS). WS2812x datasheet reference circuit puts one per LED, but 2026-10-01 user decision (matching complicated_wires' precedent of a single 'optional' cap on a 20-LED chain) keeps only this one, on the chain's first/most signal-sensitive LED; D2-D4 omit theirs."
			(at 342.9 208.28 0)
			(hide yes)
			(show_name no)
			(do_not_autoplace no)
			(effects
				(font
					(size 1.27 1.27)
				)
			)
