			)
			(justify left bottom)
		)
		(uuid "737a1e57-1c99-4608-959a-559cf1d43197")
	)
	(text "Index order for firmware tables (manual table order): 0=Red 1=Blue 2=Green 3=Yellow. Panel position: Blue=top Yellow=right Green=bottom Red=left (diamond)."
