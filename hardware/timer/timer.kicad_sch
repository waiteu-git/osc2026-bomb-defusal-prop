	(uuid "666ebaab-c68e-41d4-bf0e-3386c25b9236")
	(paper "A2")
	(title_block
		(title "Timer + host board (2x Pico 2, 80x80mm)")
		(date "2026-09-30")
		(rev "3")
		(comment 1 "OSC2026 bomb defusal prop - timer/strike display + host (5 module slots) on one board")
		(comment 2 "U1 = timer/master Pico (TM1637, strike LEDs), U3 = host/communication Pico (J1-J5 UART, J7 I2C, J8 switches); U1<->U3 on-board UART M_TX/M_RX")
		(comment 3 "TM1637 supplied from +5V (JP1 removed 2026-09-30). U1 3.3V (+3.3V) and U3 3.3V (+3V3_H) are separate rails - never tie them together")
		(comment 4 "Hand-edited in KiCad: change by targeted patch only, never regenerate (see hardware/timer/timer_design_notes.md)")
	)
